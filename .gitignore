# CareFlow: what must not be committed.

# ---- Secrets -------------------------------------------------------------------------------------
# API keys live in capstone-data-toolkit/.env (and optionally app/.env). Only the .env.example
# template is tracked.
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
*.crt
credentials*.json
service-account*.json
secrets.*
*.secret
.netrc
.pypirc

# ---- Run-time output of the application -----------------------------------------------------------
# Databases, session checkpoints, the Qdrant index, the embedding cache, logs, traces and
# evaluation results are all written here and rebuilt by the scripts.
app/out/

# Local databases, vector stores and logs written anywhere else
*.db
*.sqlite
*.sqlite3
*.log
qdrant_storage/
qdrant_data/
local_qdrant/
checkpoints/
*.ckpt
langfuse_exports/
traces/

# ---- Python ---------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments, any name or depth
.venv*/
**/.venv/
venv/
env/
ENV/

# Test, type-check and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ---- Editors, tools and operating system ----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.code-workspace
.claude/
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Scratch files and archives -------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.orig
*.rej
scratch/
tmp/
temp/
.tmp/
*.zip
*.tar
*.tar.gz
*.7z
~$*
node_modules/
