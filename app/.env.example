# CareFlow application settings. Every value below is the default, so this file is optional:
# copy it to app/.env (ignored by git) and change only what you need. The same names can be set as
# environment variables instead. API keys go in capstone-data-toolkit/.env, not here.

# ---- Model -----------------------------------------------------------------------------------------
# Any LiteLLM model string, e.g. openrouter/meta-llama/llama-3.3-70b-instruct or ollama/llama3.1:8b
CAREFLOW_MODEL=gemini/gemini-flash-lite-latest
# Comma-separated; tried in order when the first model keeps failing
CAREFLOW_FALLBACK_MODELS=gemini/gemini-flash-latest
REQUEST_TIMEOUT_S=90
TRANSPORT_RETRIES=3

# ---- Policy search ----------------------------------------------------------------------------------
# "local" uses an offline embedder (no API calls)
CAREFLOW_EMBEDDING_MODEL=gemini/gemini-embedding-001
CAREFLOW_EMBEDDING_DIMENSIONS=768
CAREFLOW_EMBEDDING_TEXTS_PER_MINUTE=90
# pdf | markdown: which copy of the corpus the index is built from
CAREFLOW_POLICY_SOURCE=pdf
# "none" switches reranking off
CAREFLOW_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
# Below this best rerank score the search abstains and the question goes to staff
CAREFLOW_RERANK_MIN_SCORE=0.03
CAREFLOW_RETRIEVAL_CANDIDATES=20
# A Qdrant server URL; empty uses the local index in app/out/qdrant
CAREFLOW_QDRANT_URL=

# ---- Guardrails -------------------------------------------------------------------------------------
# local | hosted | none (rules only)
CAREFLOW_GUARD_CLASSIFIER=local
# Seconds the input-gate classifier may take before the message is refused (fail closed)
CAREFLOW_GUARD_TIMEOUT_S=2.0

# ---- Reliability ------------------------------------------------------------------------------------
CAREFLOW_TOOL_RETRIES=3
CAREFLOW_BREAKER_FAILURES=3
CAREFLOW_BREAKER_COOLDOWN_S=30

# ---- Tracing ----------------------------------------------------------------------------------------
# off | jsonl (app/out/traces.jsonl) | langfuse (needs both keys below, else falls back to jsonl)
CAREFLOW_TRACING=jsonl
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---- API --------------------------------------------------------------------------------------------
# If set, every /v1 request must send it in the X-API-Key header
CAREFLOW_API_KEY=
# true: the API reaches the EHR tools through the MCP server process
CAREFLOW_API_USE_MCP=true

# ---- Where run-time files go (defaults are under app/out/) ------------------------------------------
# CAREFLOW_RUNTIME_DB=
# CAREFLOW_SESSIONS_DB=
# CAREFLOW_QDRANT_PATH=
# CAREFLOW_EMBED_CACHE=
